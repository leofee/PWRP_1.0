<svg viewBox="0 0 600 450" xmlns="http://www.w3.org/2000/svg" class="weld-svg">
  <defs>
    <linearGradient id="bgGrad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#0a1628"/>
      <stop offset="100%" stop-color="#1a2a4a"/>
    </linearGradient>
    <linearGradient id="barGrad" x1="0" y1="1" x2="0" y2="0">
      <stop offset="0%" stop-color="rgba(64,169,255,0.1)"/>
      <stop offset="100%" stop-color="rgba(64,169,255,0.6)"/>
    </linearGradient>
    <linearGradient id="armGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#40a9ff"/>
      <stop offset="100%" stop-color="#1890ff"/>
    </linearGradient>
    <filter id="glow">
      <feGaussianBlur stdDeviation="3" result="blur"/>
      <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
    <filter id="glowStrong">
      <feGaussianBlur stdDeviation="6" result="blur"/>
      <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
  </defs>

  <!-- Decorative circles -->
  <circle cx="120" cy="80" r="100" fill="none" stroke="rgba(64,169,255,0.08)" stroke-width="2"/>
  <circle cx="140" cy="100" r="60" fill="none" stroke="rgba(64,169,255,0.12)" stroke-width="1.5"/>
  <circle cx="480" cy="350" r="80" fill="none" stroke="rgba(64,169,255,0.06)" stroke-width="1.5"/>

  <!-- Grid lines -->
  <line x1="50" y1="380" x2="550" y2="380" stroke="rgba(255,255,255,0.06)" stroke-width="1"/>
  <line x1="50" y1="350" x2="550" y2="350" stroke="rgba(255,255,255,0.04)" stroke-width="1"/>
  <line x1="50" y1="320" x2="550" y2="320" stroke="rgba(255,255,255,0.04)" stroke-width="1"/>

  <!-- Data bars -->
  <g>
    <rect x="100" y="280" width="28" height="100" rx="4" fill="url(#barGrad)">
      <animate attributeName="height" values="100;120;90;100" dur="3s" repeatCount="indefinite"/>
      <animate attributeName="y" values="280;260;290;280" dur="3s" repeatCount="indefinite"/>
    </rect>
    <rect x="140" y="250" width="28" height="130" rx="4" fill="url(#barGrad)">
      <animate attributeName="height" values="130;100;140;130" dur="2.8s" repeatCount="indefinite"/>
      <animate attributeName="y" values="250;280;240;250" dur="2.8s" repeatCount="indefinite"/>
    </rect>
    <rect x="180" y="300" width="28" height="80" rx="4" fill="url(#barGrad)">
      <animate attributeName="height" values="80;110;70;80" dur="3.2s" repeatCount="indefinite"/>
      <animate attributeName="y" values="300;270;310;300" dur="3.2s" repeatCount="indefinite"/>
    </rect>
    <rect x="220" y="260" width="28" height="120" rx="4" fill="url(#barGrad)">
      <animate attributeName="height" values="120;90;130;120" dur="2.5s" repeatCount="indefinite"/>
      <animate attributeName="y" values="260;290;250;260" dur="2.5s" repeatCount="indefinite"/>
    </rect>
    <rect x="260" y="230" width="28" height="150" rx="4" fill="url(#barGrad)">
      <animate attributeName="height" values="150;130;160;150" dur="3.5s" repeatCount="indefinite"/>
      <animate attributeName="y" values="230;250;220;230" dur="3.5s" repeatCount="indefinite"/>
    </rect>
  </g>

  <!-- Robot arm base -->
  <rect x="350" y="360" width="60" height="20" rx="4" fill="#1e3a6a"/>
  <rect x="365" y="340" width="30" height="25" rx="3" fill="#2a4a8a"/>

  <!-- Robot arm segments -->
  <g>
    <line x1="380" y1="340" x2="380" y2="260" stroke="#40a9ff" stroke-width="8" stroke-linecap="round">
      <animate attributeName="y2" values="260;240;280;260" dur="4s" repeatCount="indefinite"/>
    </line>
    <line x1="380" y1="260" x2="440" y2="200" stroke="#1890ff" stroke-width="6" stroke-linecap="round">
      <animate attributeName="x2" values="440;460;420;440" dur="4s" repeatCount="indefinite"/>
      <animate attributeName="y2" values="200;180;220;200" dur="4s" repeatCount="indefinite"/>
    </line>
  </g>

  <!-- Joint circles -->
  <circle cx="380" cy="340" r="6" fill="#60d0ff" filter="url(#glow)"/>
  <circle cx="380" cy="260" r="5" fill="#60d0ff" filter="url(#glow)">
    <animate attributeName="cy" values="260;240;280;260" dur="4s" repeatCount="indefinite"/>
  </circle>
  <circle cx="440" cy="200" r="4" fill="#60d0ff" filter="url(#glow)">
    <animate attributeName="cx" values="440;460;420;440" dur="4s" repeatCount="indefinite"/>
    <animate attributeName="cy" values="200;180;220;200" dur="4s" repeatCount="indefinite"/>
  </circle>

  <!-- Welding torch head -->
  <g>
    <animateTransform attributeName="transform" type="translate" values="0,0;20,-20;-20,20;0,0" dur="4s" repeatCount="indefinite"/>
    <line x1="440" y1="200" x2="475" y2="185" stroke="#888" stroke-width="4" stroke-linecap="round"/>
    <rect x="470" y="175" width="14" height="20" rx="3" fill="#555" transform="rotate(-20,477,185)"/>
  </g>

  <!-- Welding sparks -->
  <g filter="url(#glowStrong)">
    <circle cx="485" cy="190" r="3" fill="#ffd700">
      <animate attributeName="opacity" values="1;0.2;1" dur="0.6s" repeatCount="indefinite"/>
      <animate attributeName="r" values="3;5;3" dur="0.6s" repeatCount="indefinite"/>
    </circle>
    <circle cx="492" cy="182" r="2" fill="#ffaa00">
      <animate attributeName="opacity" values="0;1;0" dur="0.4s" repeatCount="indefinite"/>
      <animate attributeName="cx" values="492;500;492" dur="0.8s" repeatCount="indefinite"/>
      <animate attributeName="cy" values="182;170;182" dur="0.8s" repeatCount="indefinite"/>
    </circle>
    <circle cx="495" cy="198" r="1.5" fill="#ff6600">
      <animate attributeName="opacity" values="1;0;1" dur="0.5s" repeatCount="indefinite"/>
      <animate attributeName="cx" values="495;505;495" dur="1s" repeatCount="indefinite"/>
      <animate attributeName="cy" values="198;185;198" dur="1s" repeatCount="indefinite"/>
    </circle>
    <circle cx="480" cy="195" r="1.5" fill="#ffd700">
      <animate attributeName="opacity" values="0.3;1;0.3" dur="0.35s" repeatCount="indefinite"/>
      <animate attributeName="r" values="1.5;3;1.5" dur="0.35s" repeatCount="indefinite"/>
    </circle>
    <circle cx="490" cy="192" r="1" fill="#fff">
      <animate attributeName="opacity" values="0;1;0" dur="0.3s" repeatCount="indefinite"/>
      <animate attributeName="cx" values="490;498;490" dur="0.6s" repeatCount="indefinite"/>
    </circle>
  </g>

  <!-- Spark arc flash -->
  <path d="M480,188 Q490,175 485,192" fill="none" stroke="#ffd700" stroke-width="1.5" opacity="0.6">
    <animate attributeName="opacity" values="0.6;0;0.6" dur="0.3s" repeatCount="indefinite"/>
  </path>

  <!-- Welding workpiece (metal plates) -->
  <rect x="460" y="200" width="60" height="6" rx="1" fill="#667"/>
  <rect x="470" y="206" width="50" height="6" rx="1" fill="#556"/>

  <!-- Connection nodes (network) -->
  <g>
    <circle cx="80" cy="200" r="5" fill="#40a9ff" filter="url(#glow)">
      <animate attributeName="r" values="5;7;5" dur="2s" repeatCount="indefinite"/>
    </circle>
    <circle cx="160" cy="160" r="4" fill="#40a9ff" filter="url(#glow)"/>
    <circle cx="200" cy="220" r="4" fill="#40a9ff" filter="url(#glow)"/>
    <circle cx="100" cy="270" r="3" fill="rgba(64,169,255,0.6)"/>
  </g>
  <line x1="80" y1="200" x2="160" y2="160" stroke="rgba(64,169,255,0.2)" stroke-width="1.5"/>
  <line x1="80" y1="200" x2="200" y2="220" stroke="rgba(64,169,255,0.15)" stroke-width="1.5"/>
  <line x1="80" y1="200" x2="100" y2="270" stroke="rgba(64,169,255,0.12)" stroke-width="1"/>
  <line x1="160" y1="160" x2="200" y2="220" stroke="rgba(64,169,255,0.15)" stroke-width="1"/>
  <line x1="200" y1="220" x2="100" y2="270" stroke="rgba(64,169,255,0.1)" stroke-width="1"/>

  <!-- Floating data dots -->
  <circle cx="500" cy="100" r="2" fill="rgba(64,169,255,0.4)">
    <animate attributeName="opacity" values="0.4;0.1;0.4" dur="2s" repeatCount="indefinite"/>
  </circle>
  <circle cx="530" cy="130" r="2" fill="rgba(64,169,255,0.3)">
    <animate attributeName="opacity" values="0.3;0.1;0.3" dur="2.5s" repeatCount="indefinite"/>
  </circle>
  <circle cx="480" cy="150" r="1.5" fill="rgba(64,169,255,0.35)">
    <animate attributeName="opacity" values="0.35;0.05;0.35" dur="1.8s" repeatCount="indefinite"/>
  </circle>

  <!-- Data flow path (dashed) -->
  <path d="M70,200 Q300,100 480,190" fill="none" stroke="rgba(64,169,255,0.08)" stroke-width="1.5" stroke-dasharray="4,6">
    <animate attributeName="stroke-dashoffset" values="0;-30" dur="2s" repeatCount="indefinite"/>
  </path>
</svg>